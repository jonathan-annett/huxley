.vscode/
.idea/
*.swp
*.swo
*~

# Compiled reference build and emulator binary
packages/emu86/reference/8086tiny
packages/emu86/emu86

# Compiled test binaries (executables have no extension)
packages/emu86/test/unit/test_*
!packages/emu86/test/unit/test_*.c
!packages/emu86/test/unit/test_*.h
!packages/emu86/test/unit/test_*.sh
# Differential test harness (EMU-16)
packages/emu86/harness/harness
packages/emu86/harness/obj/

# Task deploy scripts — brief is captured in tasks/*.md, script itself is ephemeral
emu*-task.sh
!images/fetch-images.sh

# Test disk images
packages/emu86/test/images/*.img
packages/emu86/test/images/*.img.gz
!packages/emu86/test/images/.gitkeep

# Node
node_modules/
package-lock.json

# Editor build output
packages/editor/client/dist/
packages/editor/server/dist/

